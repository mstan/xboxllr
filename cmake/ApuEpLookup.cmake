# Local, owner-supplied EP ROM. Keep its bytes in private build output only.
function(xlle_prepare_ep_lookup source output)
  if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
    message(FATAL_ERROR "DSP execution requires the owned verified EP lookup image")
  endif()
  file(SIZE "${source}" size)
  file(SHA256 "${source}" sha)
  if(NOT size EQUAL 8192 OR NOT sha STREQUAL "9f2cb3fdbb541a80f4b2b49de094949c88b4edcd4305d3c764ff0de2a852a414")
    message(FATAL_ERROR "Unreviewed EP lookup image")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(READ "${source}" bytes HEX)
  string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u,\n" words "${bytes}")
  get_filename_component(directory "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  set(content "#pragma once\n#include <cstdint>\nstatic constexpr uint32_t kMachineEpYLookup[]={\n${words}};\nstatic_assert(sizeof(kMachineEpYLookup)==8192,\"EP lookup size\");\n")
  if(EXISTS "${output}")
    file(READ "${output}" prior)
    if(prior STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${output}" "${content}")
endfunction()
