# Check prepared source identity, independently of whether an external archive
# exists. This does not attest which source an externally built library used.
function(xlle_validate_dsp_source source)
  set(manifest "${source}/donor.json")
  if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "DSP donor.json is missing; run tools/native_dsp_donor.py")
  endif()
  file(READ "${manifest}" record)
  string(JSON schema ERROR_VARIABLE error GET "${record}" preparation schema)
  if(error OR NOT schema STREQUAL "xboxllr.dsp-prepared-source.v1")
    message(FATAL_ERROR "Stale DSP preparation; run the current tools/native_dsp_donor.py into a fresh build directory")
  endif()
  string(JSON revision ERROR_VARIABLE error GET "${record}" revision)
  if(error OR NOT revision STREQUAL "c60aeedb6a6014850204c71e53bc0cf5b3104222")
    message(FATAL_ERROR "Unreviewed prepared DSP revision")
  endif()
  set(dependencies "${manifest}")
  foreach(name native_dsp_donor.py native_dsp_sen.py)
    set(generator "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/${name}")
    file(SHA256 "${generator}" actual)
    string(JSON expected ERROR_VARIABLE error GET "${record}" preparation generators "${name}")
    if(error OR NOT actual STREQUAL expected)
      message(FATAL_ERROR "Stale DSP generator identity (${name}); prepare a fresh donor with the current tools")
    endif()
    list(APPEND dependencies "${generator}")
  endforeach()
  string(JSON count ERROR_VARIABLE error LENGTH "${record}" sources)
  if(error OR count LESS 1)
    message(FATAL_ERROR "Prepared DSP source inventory is missing")
  endif()
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${record}" sources ${index})
    string(REPLACE "\\" "/" portable_name "${name}")
    if(IS_ABSOLUTE "${portable_name}" OR portable_name MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Invalid prepared DSP source path")
    endif()
    string(JSON expected ERROR_VARIABLE unpatched GET "${record}" guarded "${name}")
    if(unpatched)
      string(JSON expected GET "${record}" sources "${name}")
    endif()
    set(path "${source}/${name}")
    if(NOT EXISTS "${path}")
      message(FATAL_ERROR "Prepared DSP source is missing: ${name}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Prepared DSP source hash mismatch: ${name}")
    endif()
    list(APPEND dependencies "${path}")
  endforeach()
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dependencies})
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED SOURCE)
    message(FATAL_ERROR "Pass -DSOURCE=<prepared DSP directory>")
  endif()
  xlle_validate_dsp_source("${SOURCE}")
endif()
