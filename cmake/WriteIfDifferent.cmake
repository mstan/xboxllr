# Preserve dependency timestamps when a configure-time derivation is unchanged.
# Callers still perform every pinned-source check and construct the full output.
include_guard(GLOBAL)
function(xlle_write_if_different path content)
  if(EXISTS "${path}")
    file(READ "${path}" _xlle_existing_content)
    if(_xlle_existing_content STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

# The pinned Unicorn configure writes these two headers through OUTPUT_FILE on
# every configure. Keep snapshots local to this build, restore only identical
# bytes, and leave all compiler command/dependency checks to CMake/Ninja.
function(xlle_snapshot_unicorn_config_headers build_root)
  file(REAL_PATH "${build_root}" _xlle_root)
  file(REAL_PATH "${CMAKE_BINARY_DIR}" _xlle_expected_root)
  if(NOT _xlle_root STREQUAL _xlle_expected_root)
    message(FATAL_ERROR "Unicorn header snapshots must use this build root")
  endif()
  set(_xlle_snapshots)
  foreach(_xlle_relative config-host.h x86_64-softmmu/config-target.h)
    set(_xlle_path "${_xlle_root}/${_xlle_relative}")
    if(EXISTS "${_xlle_path}")
      get_filename_component(_xlle_parent "${_xlle_relative}" DIRECTORY)
      set(_xlle_snapshot_dir "${_xlle_root}/generated/unicorn-config-snapshots/${_xlle_parent}")
      file(MAKE_DIRECTORY "${_xlle_snapshot_dir}")
      file(COPY "${_xlle_path}" DESTINATION "${_xlle_snapshot_dir}")
      list(APPEND _xlle_snapshots "${_xlle_relative}")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY XLLE_UNICORN_CONFIG_SNAPSHOTS "${_xlle_snapshots}")
endfunction()

function(xlle_restore_unchanged_unicorn_config_headers build_root)
  file(REAL_PATH "${build_root}" _xlle_root)
  file(REAL_PATH "${CMAKE_BINARY_DIR}" _xlle_expected_root)
  if(NOT _xlle_root STREQUAL _xlle_expected_root)
    message(FATAL_ERROR "Unicorn header snapshots must use this build root")
  endif()
  get_property(_xlle_snapshots GLOBAL PROPERTY XLLE_UNICORN_CONFIG_SNAPSHOTS)
  foreach(_xlle_relative IN LISTS _xlle_snapshots)
    set(_xlle_path "${_xlle_root}/${_xlle_relative}")
    set(_xlle_snapshot "${_xlle_root}/generated/unicorn-config-snapshots/${_xlle_relative}")
    if(EXISTS "${_xlle_path}" AND EXISTS "${_xlle_snapshot}")
      file(SHA256 "${_xlle_path}" _xlle_current_sha)
      file(SHA256 "${_xlle_snapshot}" _xlle_snapshot_sha)
      if(_xlle_current_sha STREQUAL _xlle_snapshot_sha)
        get_filename_component(_xlle_parent "${_xlle_path}" DIRECTORY)
        file(COPY "${_xlle_snapshot}" DESTINATION "${_xlle_parent}")
      endif()
    endif()
  endforeach()
endfunction()
