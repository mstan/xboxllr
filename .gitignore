[Ee][Ee][Pp][Rr][Oo][Mm]*.[Cc][Ff][Gg]
[Ee][Ee][Pp][Rr][Oo][Mm]*.[Ii][Nn][Ii]
console-identity*
*.gpr
*.rep/

# Build + generated (evidence, not authority)
build/
build-release/
build-*/
out/
generated/
__pycache__/
*.pyc
*.blockpack
*.aot-private.*
traces/
cosim-logs/
*.jsonl

# nxdk build artifacts (agent/ builds in-tree)
*.obj
*.lib
*.exe
agent/bin/

# External reference / harvest checkouts (kept out of tree; live in the workspace parent)
xemu/
# Deliberate licensed source import; not an external checkout or guest data.
!/src/third_party/xemu/
Cxbx-Reloaded/
xboxrecomp-ref/
cromwell/
unicorn/
refs/
*.d

# Measurement evidence. Reports, frame dumps and run logs are evidence, not authority:
# they live under build/ (already ignored above), and these suffix rules stop a stray run
# from adding one anywhere else -- tools/bench/run_*.log is the case that motivated them.
# The tracked reference identities are goldens/*.json, which none of these match.
*.report.json
*.argv.json
*.quiescence.json
*.ppm
*.png
!/docs/screenshots/dashboard.png
!/docs/screenshots/jsrf-widescreen.png
*.log
