*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
*.zst
flash*.bin
mcpx*.bin
eeprom*.bin
bios/
hdd*.img
hdd*.raw
kernel*.img
*.xbe
*.xiso
*.iso
disc/

