# Copyrighted / per-console secret bytes — NEVER commit. See docs/INPUTS.md.
# NOTE: anchored to the repo root so it only ignores a top-level machine/ dump dir and does
# NOT swallow the src/machine/ device sources (an unanchored `machine/` matched both).
/machine/
*.bin
*.raw
flash*.bin
mcpx*.bin
eeprom*.bin
bios/
hdd*.img
hdd*.raw
kernel*.img
*.xbe
*.xiso
*.iso
disc/

# Build + generated (evidence, not authority)
build/
build-release/
build-*/
out/
generated/
__pycache__/
*.pyc
*.blockpack
traces/
cosim-logs/
*.jsonl

# nxdk build artifacts (agent/ builds in-tree)
*.obj
*.lib
*.exe
agent/bin/

# External reference / harvest checkouts (kept out of tree; live in the workspace parent)
xemu/
Cxbx-Reloaded/
xboxrecomp-ref/
cromwell/
unicorn/
refs/
*.d

# Measurement evidence. Reports, frame dumps and run logs are evidence, not authority:
# they live under build/ (already ignored above), and these suffix rules stop a stray run
# from adding one anywhere else -- tools/bench/run_*.log is the case that motivated them.
# The tracked reference identities are goldens/*.json, which none of these match.
*.report.json
*.argv.json
*.quiescence.json
*.ppm
*.png
*.log
