set(PILOT_DISPLAY "NATIVE" CACHE STRING "Display clock/flip boundary: NATIVE or LLE")
set_property(CACHE PILOT_DISPLAY PROPERTY STRINGS NATIVE LLE)
option(PILOT_DISPLAY_QUALIFICATION "Test-only selected display API/lifetime consumer; exits before game entry continues" OFF)
if(PILOT_DISPLAY_QUALIFICATION)
  if(NOT PILOT_DISPLAY STREQUAL "LLE")
    message(FATAL_ERROR "Display qualification requires the LLE display selection")
  endif()
  set_property(SOURCE runtime.c APPEND PROPERTY COMPILE_DEFINITIONS PILOT_DISPLAY_QUALIFICATION)
endif()
if(PILOT_DISPLAY STREQUAL "LLE")
  if(NOT PILOT_USB STREQUAL "LLE" OR NOT PILOT_RENDERER STREQUAL "D3D11")
    message(FATAL_ERROR "Display floor currently uses the shared USB/PIC floor and native renderer")
  endif()
  if(NOT EXISTS "${PILOT_GENERATED}/pilot_display_bindings.h")
    message(FATAL_ERROR "Generate verified original display bindings")
  endif()
  set(PILOT_DISPLAY_LIBRARY "" CACHE FILEPATH "Maintained private xlle_nv2a_reference DLL")
  set(PILOT_DISPLAY_DEPENDENCIES "" CACHE PATH "Reference DLL runtime dependencies")
  if(NOT EXISTS "${PILOT_DISPLAY_LIBRARY}" OR NOT IS_DIRECTORY "${PILOT_DISPLAY_DEPENDENCIES}")
    message(FATAL_ERROR "Build xlle_nv2a_reference and provide its runtime dependency directory")
  endif()
  file(TO_CMAKE_PATH "${PILOT_DISPLAY_LIBRARY}" display_library)
  file(TO_CMAKE_PATH "${PILOT_DISPLAY_DEPENDENCIES}" display_dependencies)
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/display-private")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/display-private/display_lle_config.h"
    "#define PILOT_DISPLAY_LIBRARY L\"${display_library}\"\n#define PILOT_DISPLAY_DEPENDENCIES L\"${display_dependencies}\"\n")
  set_property(SOURCE runtime.c APPEND PROPERTY COMPILE_DEFINITIONS PILOT_DISPLAY_LLE)
  target_include_directories(xlle_native_title PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/display-private")
elseif(NOT PILOT_DISPLAY STREQUAL "NATIVE")
  message(FATAL_ERROR "PILOT_DISPLAY must be NATIVE or LLE")
endif()
