set(PILOT_FILES "NATIVE" CACHE STRING "File/cache kernel services: NATIVE or LLE")
set_property(CACHE PILOT_FILES PROPERTY STRINGS NATIVE LLE)
if(PILOT_FILES STREQUAL "LLE")
  if(NOT PILOT_CACHE STREQUAL "ORIGINAL" OR NOT PILOT_MEDIA STREQUAL "INSTALLED")
    message(FATAL_ERROR "Current files LLE qualification requires ORIGINAL utility cache and approved INSTALLED media")
  endif()
  if(NOT PILOT_MEMORY STREQUAL "LLE" OR NOT PILOT_USB STREQUAL "LLE")
    message(FATAL_ERROR "Files LLE requires the shared original memory/PIC bridge")
  endif()
  set(PILOT_FILES_LIBRARY "" CACHE FILEPATH "Maintained private xlle_storage_reference DLL")
  set(PILOT_FILES_DEPENDENCIES "" CACHE PATH "Reference DLL dependencies")
  set(PILOT_FILES_HDD "" CACHE FILEPATH "Separately provisioned writable runtime HDD image")
  set(PILOT_FILES_TITLE_ROOT "" CACHE STRING "Installed title root inside the original HDD namespace")
  if(NOT EXISTS "${PILOT_FILES_LIBRARY}" OR NOT IS_DIRECTORY "${PILOT_FILES_DEPENDENCIES}" OR
     NOT EXISTS "${PILOT_FILES_HDD}" OR PILOT_FILES_TITLE_ROOT STREQUAL "")
    message(FATAL_ERROR "Files LLE requires its library, dependencies, separate HDD and installed-title root")
  endif()
  file(TO_CMAKE_PATH "${PILOT_FILES_LIBRARY}" files_library)
  file(TO_CMAKE_PATH "${PILOT_FILES_DEPENDENCIES}" files_dependencies)
  file(TO_CMAKE_PATH "${PILOT_FILES_HDD}" files_hdd)
  string(REPLACE "\\" "\\\\" files_root "${PILOT_FILES_TITLE_ROOT}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/files-private")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/files-private/files_lle_config.h"
    "#define PILOT_FILES_LIBRARY L\"${files_library}\"\n#define PILOT_FILES_DEPENDENCIES L\"${files_dependencies}\"\n#define PILOT_FILES_HDD \"${files_hdd}\"\n#define PILOT_FILES_TITLE_ROOT \"${files_root}\"\n")
  target_compile_definitions(pilot_io_device_lle PRIVATE PILOT_FILES_LLE)
  target_include_directories(pilot_io_device_lle PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/files-private")
  set_property(SOURCE runtime.c APPEND PROPERTY COMPILE_DEFINITIONS PILOT_FILES_LLE)
  target_include_directories(xlle_native_title PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/files-private")
  add_executable(pilot_files_lle_test files_lle_test.c)
  target_include_directories(pilot_files_lle_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/files-private")
  target_link_libraries(pilot_files_lle_test PRIVATE pilot_io_device_lle)
elseif(NOT PILOT_FILES STREQUAL "NATIVE")
  message(FATAL_ERROR "PILOT_FILES must be NATIVE or LLE")
endif()
