file(MAKE_DIRECTORY "${OUTPUT}/lib" "${OUTPUT}/include")
configure_file("${LIBRARY}" "${OUTPUT}/lib/unicorn.lib" COPYONLY)
file(COPY "${SOURCE}/include/unicorn" DESTINATION "${OUTPUT}/include")
configure_file("${SOURCE}/COPYING" "${OUTPUT}/COPYING" COPYONLY)
configure_file("${SOURCE}/COPYING.LGPL2" "${OUTPUT}/COPYING.LGPL2" COPYONLY)
configure_file("${HELPER_HEADER}" "${OUTPUT}/include/unicorn_irq_boundary.h" COPYONLY)
file(MAKE_DIRECTORY "${OUTPUT}/source")
configure_file("${FPU_CORRECTED}" "${OUTPUT}/source/fpu_helper.c" COPYONLY)
file(SHA256 "${LIBRARY}" library_sha)
file(SHA256 "${HELPER_SOURCE}" helper_sha)
file(SHA256 "${HELPER_HEADER}" helper_header_sha)
set(public_headers "")
file(GLOB headers "${OUTPUT}/include/unicorn/*.h")
foreach(header IN LISTS headers)
  get_filename_component(name "${header}" NAME)
  file(SHA256 "${header}" header_sha)
  if(public_headers)
    string(APPEND public_headers ",\n")
  endif()
  string(APPEND public_headers "    \"${name}\": \"${header_sha}\"")
endforeach()
file(WRITE "${OUTPUT}/engine.aot-private.json"
  "{\n  \"api\": \"xlle-unicorn-irq-v1\",\n  \"source_commit\": \"8028ec436f2d9376525352dd38ed9ed6b9f6be10\",\n  \"library_sha256\": \"${library_sha}\",\n  \"helper_sha256\": \"${helper_sha}\",\n  \"helper_header_sha256\": \"${helper_header_sha}\",\n  \"fxstate_patch_sha256\": \"${FXSTATE_PATCH_SHA}\",\n  \"fpu_original_sha256\": \"${FPU_ORIGINAL_SHA}\",\n  \"fpu_compiled_sha256\": \"${FPU_CORRECTED_SHA}\",\n  \"public_headers\": {\n${public_headers}\n  },\n  \"qualification\": \"source identity only; executable qualification is recorded separately\"\n}\n")
