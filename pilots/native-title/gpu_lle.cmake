# Whole original renderer: preserved XDK bodies drive the maintained NV2A.
# This is a bring-up selection, not a claim of qualified title rendering.
if(PILOT_RENDERER STREQUAL "LLE")
  if(NOT PILOT_USB STREQUAL "LLE" OR NOT PILOT_DISPLAY STREQUAL "NATIVE")
    message(FATAL_ERROR "Whole GPU LLE requires the shared original machine bus and excludes the separate native-rendered display floor")
  endif()
  set(PILOT_GPU_LIBRARY "" CACHE FILEPATH "Maintained private xlle_nv2a_reference DLL")
  set(PILOT_GPU_DEPENDENCIES "" CACHE PATH "Reference DLL runtime dependencies")
  if(NOT EXISTS "${PILOT_GPU_LIBRARY}" OR NOT IS_DIRECTORY "${PILOT_GPU_DEPENDENCIES}")
    message(FATAL_ERROR "Build xlle_nv2a_reference and provide its runtime dependency directory")
  endif()
  file(TO_CMAKE_PATH "${PILOT_GPU_LIBRARY}" gpu_library)
  file(TO_CMAKE_PATH "${PILOT_GPU_DEPENDENCIES}" gpu_dependencies)
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/gpu-private")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/gpu-private/gpu_lle_config.h"
    "#define PILOT_GPU_LIBRARY L\"${gpu_library}\"\n#define PILOT_GPU_DEPENDENCIES L\"${gpu_dependencies}\"\n")
  set_property(SOURCE runtime.c APPEND PROPERTY COMPILE_DEFINITIONS PILOT_GPU_LLE)
  target_include_directories(xlle_native_title PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/gpu-private")
  # The contract harness contains native and LLE consumers, selected by its
  # test argument. The title selects exactly one renderer at compile time.
  target_compile_definitions(pilot_contract_test PRIVATE PILOT_GPU_LLE)
  if(PILOT_FILES STREQUAL "LLE")
    target_compile_definitions(pilot_contract_test PRIVATE PILOT_GPU_FILES_WORKER)
  endif()
  target_include_directories(pilot_contract_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/gpu-private")
  pilot_add_test(NAME pilot_gpu_lle_transport COMMAND pilot_contract_test gpu-lle-transport)
  set_tests_properties(pilot_gpu_lle_transport PROPERTIES TIMEOUT 30)
  if(PILOT_FILES STREQUAL "LLE")
    pilot_add_test(NAME pilot_gpu_thread_cpu_lle COMMAND pilot_contract_test gpu-thread-cpu-lle)
    pilot_add_test(NAME pilot_gpu_first_context_observer COMMAND pilot_contract_test gpu-first-context-observer)
    set_tests_properties(pilot_gpu_first_context_observer PROPERTIES TIMEOUT 30)
    if(TARGET pilot_callback_kernel_lle_test)
      pilot_add_test(NAME pilot_gpu_first_context_capture_guard COMMAND "${CMAKE_COMMAND}"
        "-DPROGRAM=$<TARGET_FILE:pilot_callback_kernel_lle_test>"
        "-DOUTPUT=${CMAKE_CURRENT_BINARY_DIR}/first-context-controls"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/first_context_capture_guard.cmake")
      set_tests_properties(pilot_gpu_first_context_capture_guard PROPERTIES TIMEOUT 30)
    endif()
    set_tests_properties(pilot_gpu_thread_cpu_lle PROPERTIES TIMEOUT 30)
    pilot_add_test(NAME pilot_gpu_thread_av_lle COMMAND pilot_contract_test gpu-thread-av-lle)
    pilot_add_test(NAME pilot_gpu_thread_av_mode_guard COMMAND pilot_contract_test gpu-thread-av-mode-guard)
    pilot_add_test(NAME pilot_gpu_thread_av_mode_phase1_guard COMMAND pilot_contract_test gpu-thread-av-mode-phase1-guard)
    set_tests_properties(pilot_gpu_thread_av_lle pilot_gpu_thread_av_mode_guard pilot_gpu_thread_av_mode_phase1_guard PROPERTIES TIMEOUT 30)
  endif()
  pilot_add_test(NAME pilot_gpu_lle_av_mode_guard COMMAND pilot_contract_test gpu-lle-av-mode-guard)
  pilot_add_test(NAME pilot_gpu_lle_av_mode_phase1_guard COMMAND pilot_contract_test gpu-lle-av-mode-phase1-guard)
  set_tests_properties(pilot_gpu_lle_av_mode_guard pilot_gpu_lle_av_mode_phase1_guard PROPERTIES TIMEOUT 30)
  if(PILOT_FILES STREQUAL "LLE")
    pilot_add_test(NAME pilot_gpu_lle_encoder_timing COMMAND pilot_contract_test gpu-lle-encoder-timing)
    set_tests_properties(pilot_gpu_lle_encoder_timing PROPERTIES TIMEOUT 30)
    pilot_add_test(NAME pilot_gpu_lle_encoder_phase_guard COMMAND pilot_contract_test gpu-lle-encoder-phase-guard)
    set_tests_properties(pilot_gpu_lle_encoder_phase_guard PROPERTIES TIMEOUT 30)
  endif()
endif()
