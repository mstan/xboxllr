  set_tests_properties(pilot_gpu_lle_transport PROPERTIES TIMEOUT 30)
  if(PILOT_FILES STREQUAL "LLE")
    if(PILOT_AUDIO_BACKEND STREQUAL "APU_REFERENCE")
      # Private original callback closure, produced from the owner's pinned
      # generated image. Never substitute authored ISR/DPC success bodies.
      set(PILOT_GPU_AV_TEST_CALLBACKS "" CACHE FILEPATH "Private original GPU ISR/DPC callback closure for the AV integration test")
      if(PILOT_GPU_AV_TEST_CALLBACKS)
        set(PILOT_GPU_AV_TEST_XBE "" CACHE FILEPATH "Matching original image for the GPU AV integration test")
        if(NOT TARGET pilot_callback_kernel_lle_test OR NOT EXISTS "${PILOT_GPU_AV_TEST_CALLBACKS}" OR NOT EXISTS "${PILOT_GPU_AV_TEST_XBE}")
          message(FATAL_ERROR "The GPU AV integration test requires its prepared original callback closure and matching XBE")
        endif()
        target_sources(pilot_callback_kernel_lle_test PRIVATE "${PILOT_GPU_AV_TEST_CALLBACKS}")
        target_compile_definitions(pilot_callback_kernel_lle_test PRIVATE PILOT_GPU_AV_TEST_CALLBACKS)
        pilot_add_test(NAME pilot_gpu_av_interrupt_lle COMMAND pilot_callback_kernel_lle_test gpu-av-interrupt-lle "${PILOT_GPU_AV_TEST_XBE}")
        pilot_add_test(NAME pilot_gpu_av_interrupt_thread_lle COMMAND pilot_callback_kernel_lle_test gpu-av-interrupt-thread-lle "${PILOT_GPU_AV_TEST_XBE}")
        set_tests_properties(pilot_gpu_av_interrupt_lle pilot_gpu_av_interrupt_thread_lle PROPERTIES TIMEOUT 30)
        pilot_add_test(NAME pilot_gpu_av_service_counterexample_lle COMMAND pilot_callback_kernel_lle_test gpu-av-service-counterexample-lle "${PILOT_GPU_AV_TEST_XBE}")
        set_tests_properties(pilot_gpu_av_service_counterexample_lle PROPERTIES TIMEOUT 45)
      endif()
    endif()
    pilot_add_test(NAME pilot_gpu_thread_cpu_lle COMMAND pilot_contract_test gpu-thread-cpu-lle)
    pilot_add_test(NAME pilot_gpu_first_context_observer COMMAND pilot_contract_test gpu-first-context-observer)
    pilot_add_test(NAME pilot_gpu_compiled_context_prepare COMMAND pilot_contract_test gpu-compiled-context-prepare)
    set_tests_properties(pilot_gpu_compiled_context_prepare PROPERTIES TIMEOUT 30)
    set_tests_properties(pilot_gpu_first_context_observer PROPERTIES TIMEOUT 30)
    if(TARGET pilot_callback_kernel_lle_test)
      pilot_add_test(NAME pilot_gpu_first_context_capture_guard COMMAND "${CMAKE_COMMAND}"
        "-DPROGRAM=$<TARGET_FILE:pilot_callback_kernel_lle_test>"
        "-DOUTPUT=${CMAKE_CURRENT_BINARY_DIR}/first-context-controls"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/first_context_capture_guard.cmake")
      set_tests_properties(pilot_gpu_first_context_capture_guard PROPERTIES TIMEOUT 30)
    endif()
    set_tests_properties(pilot_gpu_thread_cpu_lle PROPERTIES TIMEOUT 30)
    pilot_add_test(NAME pilot_gpu_thread_av_lle COMMAND pilot_contract_test gpu-thread-av-lle)
    pilot_add_test(NAME pilot_gpu_thread_av_mode_startup COMMAND pilot_contract_test gpu-thread-av-mode-startup)
    pilot_add_test(NAME pilot_gpu_thread_av_mode_phase1_startup COMMAND pilot_contract_test gpu-thread-av-mode-phase1-startup)
    set_tests_properties(pilot_gpu_thread_av_lle pilot_gpu_thread_av_mode_startup pilot_gpu_thread_av_mode_phase1_startup PROPERTIES TIMEOUT 30)
  endif()
  pilot_add_test(NAME pilot_gpu_lle_av_mode_startup COMMAND pilot_contract_test gpu-lle-av-mode-startup)
  pilot_add_test(NAME pilot_gpu_lle_av_mode_phase1_startup COMMAND pilot_contract_test gpu-lle-av-mode-phase1-startup)
  set_tests_properties(pilot_gpu_lle_av_mode_startup pilot_gpu_lle_av_mode_phase1_startup PROPERTIES TIMEOUT 30)
