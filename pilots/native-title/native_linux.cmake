# Native Linux uses the shared generated CPU, guest services, renderer and DSP
# graph. This build graph excludes the Windows-only LLE fixture executables.
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 17)
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
  message(FATAL_ERROR "The current native Linux title host requires x86_64")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_package(Threads REQUIRED)
if(PILOT_SDL2_DIR)
  set(SDL2_DIR "${PILOT_SDL2_DIR}" CACHE PATH "Selected native SDL2 package" FORCE)
endif()
find_package(SDL2 2.24 CONFIG REQUIRED)
set(PILOT_GENERATED "" CACHE PATH "Reviewed private generated title directory")
set(PILOT_D3D_SOURCE "" CACHE PATH "native_phobos_linux.py output")
set(PILOT_DSP_SOURCE "" CACHE PATH "Prepared pinned DSP source")
set(PILOT_DSP_LIBRARY "" CACHE FILEPATH "Native Linux DSP static library")
set(PILOT_DXVK_NATIVE "" CACHE PATH "DXVK Native SDK prefix")
set(PILOT_VKD3D "" CACHE PATH "Native vkd3d installation prefix")
set(PILOT_FAUDIO "" CACHE PATH "Native FAudio installation prefix")
set(PILOT_EXECUTABLE_NAME "xlle_native_title" CACHE STRING "Native application filename")
set(PILOT_NATIVE_OPTIMIZATION "OPTIMIZED" CACHE STRING "Native CPU optimization: OPTIMIZED or BRINGUP")
set(PILOT_NATIVE_LINK_PROFILE "FINAL" CACHE STRING "Native ELF link profile")
if(NOT PILOT_NATIVE_OPTIMIZATION MATCHES "^(OPTIMIZED|BRINGUP)$" OR
   NOT PILOT_NATIVE_LINK_PROFILE STREQUAL "FINAL")
  message(FATAL_ERROR "Linux requires FINAL linking and OPTIMIZED or BRINGUP CPU optimization")
endif()
if(DEFINED PILOT_NETWORK AND NOT PILOT_NETWORK STREQUAL "ORIGINAL")
  message(FATAL_ERROR "The optional native offline network service is currently Windows-only")
endif()
if(NOT PILOT_EXECUTABLE_NAME MATCHES "^[A-Za-z][A-Za-z0-9_-]*$")
  message(FATAL_ERROR "Use a plain PILOT_EXECUTABLE_NAME")
endif()
if(NOT EXISTS "${PILOT_GENERATED}/pilot_image.h" OR
   NOT EXISTS "${PILOT_GENERATED}/pilot_d3d_binding.c" OR
   NOT EXISTS "${PILOT_GENERATED}/pilot_audio_binding.c")
  message(FATAL_ERROR "Prepare and verify the original title's native bindings first")
endif()
if(EXISTS "${PILOT_GENERATED}/pilot_continuation_schema.h")
  message(FATAL_ERROR "Diagnostic continuation output is not a production native title")
endif()
foreach(setting IO_DEVICE USB)
  if(DEFINED PILOT_${setting} AND NOT PILOT_${setting} STREQUAL "OFF")
    message(FATAL_ERROR "Native Linux currently requires PILOT_${setting}=OFF; Windows reference builds remain available")
  endif()
endforeach()
foreach(setting MEMORY FILES SCHEDULING INPUT DISPLAY AUDIO)
  if(DEFINED PILOT_${setting} AND NOT PILOT_${setting} STREQUAL "NATIVE")
    message(FATAL_ERROR "Native Linux currently requires PILOT_${setting}=NATIVE")
  endif()
endforeach()
if(DEFINED PILOT_CALENDAR AND NOT PILOT_CALENDAR STREQUAL "HLE")
  message(FATAL_ERROR "Native Linux uses PILOT_CALENDAR=HLE")
endif()
if((DEFINED PILOT_RENDERER AND NOT PILOT_RENDERER STREQUAL "D3D11") OR
   (DEFINED PILOT_D3D_DONOR AND NOT PILOT_D3D_DONOR STREQUAL "PHOBOS") OR
   (DEFINED PILOT_AUDIO_BACKEND AND NOT PILOT_AUDIO_BACKEND STREQUAL "XAUDIO2_DSP"))
  message(FATAL_ERROR "Native Linux requires the reviewed PHOBOS D3D11/DSP graph")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ValidateDspSource.cmake")
xlle_validate_dsp_source("${PILOT_DSP_SOURCE}")
if(NOT EXISTS "${PILOT_DSP_LIBRARY}" OR NOT EXISTS "${PILOT_D3D_SOURCE}/linux-adapter.json")
  message(FATAL_ERROR "Build the native DSP and prepare the Linux renderer")
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../../tools/native_phobos_linux.py"
  --verify "${PILOT_D3D_SOURCE}" RESULT_VARIABLE renderer_status)
if(NOT renderer_status EQUAL 0)
  message(FATAL_ERROR "Native Linux renderer source verification failed")
endif()
find_library(pilot_dxvk_d3d11 NAMES dxvk_d3d11 HINTS "${PILOT_DXVK_NATIVE}/lib" REQUIRED NO_DEFAULT_PATH)
find_library(pilot_dxvk_dxgi NAMES dxvk_dxgi HINTS "${PILOT_DXVK_NATIVE}/lib" REQUIRED NO_DEFAULT_PATH)
find_library(pilot_vkd3d_utils NAMES vkd3d-utils HINTS "${PILOT_VKD3D}/lib" REQUIRED NO_DEFAULT_PATH)
find_library(pilot_faudio NAMES FAudio HINTS "${PILOT_FAUDIO}/lib" "${PILOT_FAUDIO}/lib/x86_64-linux-gnu" REQUIRED NO_DEFAULT_PATH)
find_path(pilot_faudio_include FAudio.h HINTS "${PILOT_FAUDIO}/include" REQUIRED NO_DEFAULT_PATH)
add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/linux" linux-host)
add_library(pilot_linux_shader STATIC linux/shader_compiler.cpp)
target_link_libraries(pilot_linux_shader PUBLIC pilot_host_posix "${pilot_vkd3d_utils}")
target_sources(pilot_host_posix PRIVATE linux/host_window.c)
target_link_libraries(pilot_host_posix PUBLIC SDL2::SDL2)
include(session_zlib.cmake)
add_library(pilot_session_replay STATIC session_replay.cpp)
target_link_libraries(pilot_session_replay PUBLIC ZLIB::ZLIBSTATIC Threads::Threads)
target_include_directories(pilot_session_replay PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
add_library(pilot_native_debug STATIC native_debug.cpp ../../src/obs/debug_server.cpp)
target_include_directories(pilot_native_debug PUBLIC "${CMAKE_CURRENT_LIST_DIR}" PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../src")
target_link_libraries(pilot_native_debug PUBLIC Threads::Threads)
add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/../../src/storage" storage)
add_library(pilot_memory_write_watch STATIC memory_write_watch.c memory_commit_owner.c)
target_compile_definitions(pilot_memory_write_watch PRIVATE PILOT_POSIX_HOST)
target_link_libraries(pilot_memory_write_watch PUBLIC pilot_host_posix)
target_include_directories(pilot_memory_write_watch PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
add_library(pilot_graphics_commands STATIC graphics_commands.c)
add_library(pilot_vsh_reference STATIC
  "${PILOT_D3D_SOURCE}/nv2a-reference/nv2a_vsh_disassembler.c"
  "${PILOT_D3D_SOURCE}/nv2a-reference/nv2a_vsh_cpu.c"
  "${PILOT_D3D_SOURCE}/nv2a-reference/nv2a_vsh_emulator.c"
  "${PILOT_D3D_SOURCE}/nv2a-reference/nv2a_vsh_emulator_execution_state.c")
target_include_directories(pilot_vsh_reference PUBLIC "${PILOT_D3D_SOURCE}/nv2a-reference")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/Nv2aVshArl.cmake")
xlle_correct_vsh_arl(pilot_vsh_reference "${PILOT_D3D_SOURCE}/nv2a-reference/nv2a_vsh_emulator.c")
set(phobos_sources "")
foreach(name d3d8_device d3d8_resources d3d8_shaders d3d8_states d3d8_combiners
    d3d8_vsh d3d8_movie d3d8_screencopy d3d8_display d3d8_compile
    rhi rhi_shader_cache rhi_d3d11)
  list(APPEND phobos_sources "${PILOT_D3D_SOURCE}/src/d3d/${name}.c")
endforeach()
add_library(pilot_d3d_backend STATIC graphics_backend.c graphics_states.c graphics_shader_backend.c linux/debug_overlay.c
  visual_mods.c visual_mod_plan.c ${phobos_sources}
  "${PILOT_D3D_SOURCE}/src/config/recomp_config.c" "${PILOT_D3D_SOURCE}/src/kernel/nv2a_vsh.c")
target_include_directories(pilot_d3d_backend PUBLIC "${PILOT_D3D_SOURCE}" "${PILOT_D3D_SOURCE}/src"
  "${PILOT_D3D_SOURCE}/src/d3d" "${PILOT_D3D_SOURCE}/src/config")
target_include_directories(pilot_d3d_backend BEFORE PRIVATE "${CMAKE_CURRENT_LIST_DIR}/linux")
target_compile_definitions(pilot_d3d_backend PRIVATE PILOT_D3D_PHOBOS PILOT_DXVK_NATIVE)
target_link_libraries(pilot_d3d_backend PUBLIC pilot_host_posix pilot_native_debug pilot_session_replay
  "${pilot_dxvk_d3d11}" "${pilot_dxvk_dxgi}" pilot_linux_shader pilot_vsh_reference m)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ApuAdpcm.cmake")
add_library(pilot_dsp STATIC audio_dsp.c)
target_compile_definitions(pilot_dsp PRIVATE PILOT_SESSION_RUNTIME)
target_include_directories(pilot_dsp PRIVATE "${PILOT_DSP_SOURCE}/crates/emu-ffi/include")
target_link_libraries(pilot_dsp PUBLIC "${PILOT_DSP_LIBRARY}" pilot_host_posix pilot_session_replay Threads::Threads ${CMAKE_DL_LIBS} m)
add_library(pilot_audio_backend STATIC audio_xaudio2.cpp)
target_include_directories(pilot_audio_backend PRIVATE "${pilot_faudio_include}")
target_compile_definitions(pilot_audio_backend PRIVATE PILOT_AUDIO_DSP PILOT_AUDIO_ADPCM)
target_link_libraries(pilot_audio_backend PUBLIC pilot_dsp pilot_session_replay xlle_apu_adpcm "${pilot_faudio}")
add_library(pilot_input_sdl STATIC input_sdl.c)
target_compile_definitions(pilot_input_sdl PRIVATE PILOT_HAVE_SDL2 SDL_MAIN_HANDLED)
target_link_libraries(pilot_input_sdl PUBLIC pilot_host_posix pilot_native_debug pilot_session_replay SDL2::SDL2)
file(GLOB generated CONFIGURE_DEPENDS "${PILOT_GENERATED}/*.c")
add_executable(xlle_native_title runtime.c input_host.c ${generated})
set_target_properties(xlle_native_title PROPERTIES OUTPUT_NAME "${PILOT_EXECUTABLE_NAME}" BUILD_RPATH
  "${PILOT_DXVK_NATIVE}/lib;${PILOT_VKD3D}/lib;${PILOT_FAUDIO}/lib;${PILOT_FAUDIO}/lib/x86_64-linux-gnu" INSTALL_RPATH "$ORIGIN/../lib")
target_include_directories(xlle_native_title PRIVATE "${PILOT_GENERATED}")
target_compile_definitions(xlle_native_title PRIVATE PILOT_SESSION_RUNTIME PILOT_D3D_NATIVE PILOT_INPUT_NATIVE PILOT_AUDIO_NATIVE PILOT_AUDIO_DSP)
target_link_libraries(xlle_native_title PRIVATE pilot_host_posix pilot_memory_write_watch pilot_graphics_commands
  pilot_session_replay pilot_native_debug xboxllr_storage pilot_input_sdl pilot_d3d_backend pilot_audio_backend m)
set(PILOT_MEDIA "HOST" CACHE STRING "Native content provider: HOST or INSTALLED")
if(PILOT_MEDIA STREQUAL "HOST")
  target_compile_definitions(xlle_native_title PRIVATE PILOT_MEDIA_HOST)
elseif(PILOT_MEDIA STREQUAL "INSTALLED")
  target_compile_definitions(xlle_native_title PRIVATE PILOT_MEDIA_INSTALLED)
else()
  message(FATAL_ERROR "Native Linux requires HOST or INSTALLED content")
endif()
foreach(binding CACHE CPU_PROBE KERNEL_CLOCK STARTUP)
  if(PILOT_${binding} STREQUAL "NATIVE")
    target_compile_definitions(xlle_native_title PRIVATE PILOT_${binding}_NATIVE)
  endif()
endforeach()
if(EXISTS "${PILOT_GENERATED}/pilot_title_binding.c")
  target_compile_definitions(xlle_native_title PRIVATE PILOT_TITLE_FUNCTIONS)
endif()
if(EXISTS "${PILOT_GENERATED}/pilot_title_runtime.h")
  target_compile_definitions(xlle_native_title PRIVATE PILOT_TITLE_RUNTIME_PROFILE)
endif()
if(PILOT_TITLE_MOD_SOURCE)
  target_sources(xlle_native_title PRIVATE "${PILOT_TITLE_MOD_SOURCE}")
  target_include_directories(xlle_native_title PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
  target_compile_definitions(xlle_native_title PRIVATE PILOT_TITLE_MODS)
endif()
if(PILOT_SECTION_MOD_SOURCE)
  target_sources(xlle_native_title PRIVATE section_mods.c "${PILOT_SECTION_MOD_SOURCE}")
  target_compile_definitions(xlle_native_title PRIVATE PILOT_SECTION_MODS)
endif()
file(STRINGS "${PILOT_GENERATED}/recomp_dispatch.c" compact REGEX "^#define PILOT_DISPATCH_COMPACT 1$")
if(compact)
  target_compile_definitions(xlle_native_title PRIVATE PILOT_DISPATCH_COMPACT)
endif()
if(PILOT_NATIVE_POLL_WAIT)
  file(READ "${PILOT_GENERATED}/pilot_poll_wait_units.json" units)
  string(JSON count LENGTH "${units}")
  if(count LESS 1)
    message(FATAL_ERROR "Native poll waits require the reviewed unit inventory")
  endif()
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON unit GET "${units}" ${index})
    if(NOT unit MATCHES "^recomp_[0-9]+\\.c$" OR NOT EXISTS "${PILOT_GENERATED}/${unit}")
      message(FATAL_ERROR "Invalid native poll unit: ${unit}")
    endif()
    set_property(SOURCE "${PILOT_GENERATED}/${unit}" APPEND PROPERTY COMPILE_DEFINITIONS PILOT_NATIVE_POLL_WAIT)
  endforeach()
endif()
set_property(SOURCE runtime.c APPEND PROPERTY COMPILE_DEFINITIONS
  "PILOT_NATIVE_OPTIMIZATION=\"${PILOT_NATIVE_OPTIMIZATION}\"" PILOT_MEMORY_WRITE_WATCH PILOT_AUDIO_ADPCM)
target_compile_options(xlle_native_title PRIVATE -O2 -fno-strict-aliasing -Werror=implicit-function-declaration)
if(PILOT_NATIVE_OPTIMIZATION STREQUAL "BRINGUP")
  target_compile_options(xlle_native_title PRIVATE -O0)
endif()
file(SHA256 "${PILOT_GENERATED}/recomp_types.h" pilot_register_model_sha256)
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/native-build-profile-$<CONFIG>.aot-private.json"
  CONTENT "{\n  \"platform\": \"linux-x86_64\",\n  \"optimization\": \"${PILOT_NATIVE_OPTIMIZATION}\",\n  \"native_poll_wait\": \"${PILOT_NATIVE_POLL_WAIT}\",\n  \"compiler\": \"${CMAKE_C_COMPILER_ID} ${CMAKE_C_COMPILER_VERSION}\",\n  \"register_model_sha256\": \"${pilot_register_model_sha256}\",\n  \"renderer\": \"DXVK Native D3D11\",\n  \"audio\": \"FAudio / DSP56300\"\n}\n")
target_link_options(xlle_native_title PRIVATE -Wl,-z,stack-size=8388608)
include(notice_staging.cmake)
pilot_notices_begin("${CMAKE_CURRENT_BINARY_DIR}")
foreach(notice LICENSE LICENSE-SCOPE.md NOTICE THIRD_PARTY_ATTRIBUTION.md)
  pilot_notice_file("${CMAKE_CURRENT_LIST_DIR}/../../${notice}" "${notice}")
endforeach()
foreach(notice LICENSE LICENSE.upstream-MIT NOTICE MODIFICATIONS.md donor.json linux-adapter.json)
  pilot_notice_file("${PILOT_D3D_SOURCE}/${notice}" "third_party/renderer/${notice}")
endforeach()
pilot_notice_tree("${PILOT_D3D_SOURCE}/LICENSES" "third_party/renderer/LICENSES")
pilot_notice_tree("${PILOT_DSP_SOURCE}/third_party" "third_party/dsp56300-dependencies")
pilot_notice_file("${PILOT_DSP_SOURCE}/LICENSE" "third_party/dsp56300/LICENSE")
pilot_notice_file("${PILOT_DSP_SOURCE}/donor.json" "third_party/dsp56300/donor.json")
pilot_notice_file("${PILOT_D3D_SOURCE}/nv2a-reference/LICENSE" "third_party/nv2a-reference/LICENSE")
if(NOT EXISTS "${PILOT_GENERATED}/third_party/phobos-xboxrecomp/LICENSE")
  message(FATAL_ERROR "Regenerate private CPU helpers with retained donor notices")
endif()
pilot_notice_tree("${PILOT_GENERATED}/third_party" "third_party")
pilot_notices_finish()
add_dependencies(xlle_native_title pilot_notices)
enable_testing()
add_executable(pilot_linux_shader_test ../../tests/test_native_linux_shader.cpp)
target_link_libraries(pilot_linux_shader_test PRIVATE pilot_linux_shader)
target_compile_options(pilot_linux_shader_test PRIVATE -UNDEBUG)
add_test(NAME native_linux_shader COMMAND pilot_linux_shader_test)
add_executable(pilot_native_cpu_service_test ../../tests/test_native_cpu_service.c)
target_link_libraries(pilot_native_cpu_service_test PRIVATE m)
add_test(NAME native_cpu_service COMMAND pilot_native_cpu_service_test)
add_custom_target(pilot_native_iteration DEPENDS xlle_native_title pilot_host_posix_test pilot_native_cpu_service_test pilot_linux_shader_test)
