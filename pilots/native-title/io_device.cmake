set(PILOT_IO_DEVICE "OFF" CACHE STRING "Original input device manager: OFF or LLE")
set_property(CACHE PILOT_IO_DEVICE PROPERTY STRINGS OFF LLE)
if(PILOT_IO_DEVICE STREQUAL "LLE")
  # Reuse the already pinned engine/notices; no second interpreter dependency.
  if(NOT PILOT_CALENDAR STREQUAL "LLE")
    message(FATAL_ERROR "Private device LLE currently requires the calendar LLE engine configuration")
  endif()
  set(PILOT_IO_DEVICE_SNAPSHOT "" CACHE FILEPATH "Owned initialized 64MiB RAM capture")
  if(NOT EXISTS "${PILOT_IO_DEVICE_SNAPSHOT}")
    message(FATAL_ERROR "Device LLE requires the owned initialized RAM capture")
  endif()
  set(io_snapshot_sha "31ede2a0e799243b3d39033a0127147b7631950087c05306e64b4203e6ea9ed1")
  file(SHA256 "${PILOT_IO_DEVICE_SNAPSHOT}" actual_sha)
  if(NOT actual_sha STREQUAL io_snapshot_sha)
    message(FATAL_ERROR "Unreviewed device LLE capture")
  endif()
  file(TO_CMAKE_PATH "${PILOT_IO_DEVICE_SNAPSHOT}" io_snapshot_path)
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/io-device-private")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/io-device-private/io_device_config.h"
    "#define PILOT_IO_DEVICE_SNAPSHOT \"${io_snapshot_path}\"\n#define PILOT_IO_DEVICE_SNAPSHOT_SHA \"${io_snapshot_sha}\"\n")
  add_library(pilot_io_device_lle STATIC io_device_lle.c)
  target_include_directories(pilot_io_device_lle PRIVATE "${PILOT_CALENDAR_UNICORN}/include"
    "${CMAKE_CURRENT_BINARY_DIR}/io-device-private")
  target_compile_definitions(pilot_io_device_lle PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
  target_link_libraries(pilot_io_device_lle PUBLIC "${PILOT_CALENDAR_UNICORN}/lib/unicorn.lib" bcrypt)
  foreach(target xlle_native_title pilot_contract_test)
    target_compile_definitions(${target} PRIVATE PILOT_IO_DEVICE_LLE)
    target_link_libraries(${target} PRIVATE pilot_io_device_lle)
  endforeach()
  add_test(NAME pilot_io_device_lle COMMAND pilot_contract_test io-device-lle)
  set_tests_properties(pilot_io_device_lle PROPERTIES TIMEOUT 30)
  add_test(NAME pilot_io_device_lle_guards COMMAND "${CMAKE_COMMAND}"
    "-DPROGRAM=$<TARGET_FILE:pilot_contract_test>" -P "${CMAKE_CURRENT_SOURCE_DIR}/io_device_guards.cmake")
  set_tests_properties(pilot_io_device_lle_guards PROPERTIES TIMEOUT 15)
elseif(NOT PILOT_IO_DEVICE STREQUAL "OFF")
  message(FATAL_ERROR "PILOT_IO_DEVICE must be OFF or LLE")
endif()
