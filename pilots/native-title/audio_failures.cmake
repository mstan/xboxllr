foreach(kind effects routing loop)
  if(kind STREQUAL "effects")
    set(expected "Xbox DSP effects image needs a real native effect implementation")
  elseif(kind STREQUAL "routing")
    set(expected "unqualified native audio service")
  else()
    set(expected "partial audio loop regions are unqualified")
  endif()
  execute_process(COMMAND "${PROGRAM}" "audio-${kind}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8)
  string(FIND "${error}" "[PILOT STOP] ${expected}" match)
  if(NOT result EQUAL 2 OR match EQUAL -1)
    message(FATAL_ERROR "Expected ${expected}, exit2; got ${result}: ${output}${error}")
  endif()
endforeach()
