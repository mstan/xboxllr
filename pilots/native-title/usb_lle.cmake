set(PILOT_USB "OFF" CACHE STRING "Original USB device path: OFF or LLE")
set_property(CACHE PILOT_USB PROPERTY STRINGS OFF LLE)
if(PILOT_USB STREQUAL "LLE")
  if(NOT pilot_calendar_irq_boundary)
    message(FATAL_ERROR "USB/PIC LLE requires the source-built Unicorn IRQ-boundary package; see unicorn-engine/README.md")
  endif()
  if(NOT PILOT_INPUT STREQUAL "NATIVE")
    target_sources(xlle_native_title PRIVATE input_host.c)
    target_link_libraries(xlle_native_title PRIVATE xinput)
  endif()
  if(NOT PILOT_IO_DEVICE STREQUAL "LLE")
    message(FATAL_ERROR "USB LLE needs the original device/page services")
  endif()
  add_library(pilot_usb_lle STATIC usb_lle.cpp mmio_fault.c ../../src/machine/ohci.cpp ../../src/machine/pic.cpp ../../src/machine/pit.cpp ../../src/machine/rtc.cpp ../../src/machine/smbus.cpp)
  target_include_directories(pilot_usb_lle PRIVATE ../../src)
  target_compile_definitions(pilot_usb_lle PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
  target_compile_definitions(pilot_io_device_lle PRIVATE PILOT_USB_LLE)
  target_link_libraries(pilot_io_device_lle PUBLIC pilot_usb_lle)
  foreach(target xlle_native_title pilot_contract_test)
    target_compile_definitions(${target} PRIVATE PILOT_USB_LLE)
    target_link_libraries(${target} PRIVATE pilot_usb_lle)
  endforeach()
  add_test(NAME pilot_usb_lle COMMAND pilot_contract_test usb-lle)
  add_test(NAME pilot_usb_irq COMMAND pilot_contract_test usb-irq)
  set_tests_properties(pilot_usb_irq PROPERTIES TIMEOUT 15)
  add_test(NAME pilot_usb_irq_clock COMMAND pilot_contract_test usb-irq-clock)
  set_tests_properties(pilot_usb_irq_clock PROPERTIES TIMEOUT 15)
  add_executable(pilot_apu_clock_test apu_clock_test.cpp)
  target_include_directories(pilot_apu_clock_test PRIVATE ../../src)
  target_compile_features(pilot_apu_clock_test PRIVATE cxx_std_17)
  add_test(NAME pilot_apu_clock COMMAND pilot_apu_clock_test)
  set_tests_properties(pilot_usb_lle PROPERTIES TIMEOUT 15)
  add_test(NAME pilot_usb_dma_guards COMMAND "${CMAKE_COMMAND}"
    "-DPROGRAM=$<TARGET_FILE:pilot_contract_test>" -P "${CMAKE_CURRENT_LIST_DIR}/usb_guards.cmake")
  set_tests_properties(pilot_usb_dma_guards PROPERTIES TIMEOUT 15)
  add_executable(pilot_mmio_fault_test mmio_fault_test.c mmio_fault.c)
  target_compile_definitions(pilot_mmio_fault_test PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
  add_test(NAME pilot_mmio_fault_decoder COMMAND pilot_mmio_fault_test)
  set_tests_properties(pilot_mmio_fault_decoder PROPERTIES TIMEOUT 5)
elseif(NOT PILOT_USB STREQUAL "OFF")
  message(FATAL_ERROR "PILOT_USB must be OFF or LLE")
endif()
