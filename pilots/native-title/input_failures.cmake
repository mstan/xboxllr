if(KIND STREQUAL "manual")
  set(expected "unqualified manual/reserved input polling mode")
elseif(KIND STREQUAL "event")
  set(expected "input feedback event handles are unqualified")
elseif(KIND STREQUAL "closed")
  set(expected "invalid or closed input handle")
elseif(KIND STREQUAL "unknown")
  set(expected "unqualified input device class")
else()
  message(FATAL_ERROR "Unknown input failure fixture")
endif()
execute_process(COMMAND "${PROGRAM}" "input-${KIND}" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8)
string(FIND "${error}" "[PILOT STOP] ${expected}" match)
if(NOT result EQUAL 2 OR match EQUAL -1)
  message(FATAL_ERROR "Expected ${expected}, exit 2; got ${result}: ${output}${error}")
endif()
