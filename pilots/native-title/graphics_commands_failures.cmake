set(guard_cases unknown record texture-live texture-reference texture-enabled declaration-shape declaration-change declaration-lighting borrowed-shape borrowed-extent borrowed-change borrowed-free vertex-change vertex-free index-shape index-change index-cache index-range index-base device-reference destroy-reference destroy-bound)
if(ORIGINAL_RETIREMENT)
  list(APPEND guard_cases retire-shared retire-abi retire-reset)
endif()
foreach(kind IN LISTS guard_cases)
  execute_process(COMMAND "${PROGRAM}" "graphics-commands-${kind}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 12)
  if(NOT "${result}" STREQUAL "2")
    message(FATAL_ERROR "inline ${kind} guard returned ${result}: ${output}${error}")
  endif()
  if(kind STREQUAL "unknown")
    set(expected "unqualified inline graphics command at 000017fc")
  elseif(kind STREQUAL "retire-shared")
    set(expected "original resource retirement requires exclusive allocation base")
  elseif(kind STREQUAL "retire-abi")
    set(expected "original allocator stdcall ABI differs")
  elseif(kind STREQUAL "retire-reset")
    set(expected "reset during callback/device close/resource wait/retirement")
  elseif(kind STREQUAL "device-reference")
    set(expected "invalid device reference acquisition")
  elseif(kind STREQUAL "destroy-reference" OR kind STREQUAL "destroy-bound")
    set(expected "destruction requires the last unbound resource reference")
  elseif(kind STREQUAL "record")
    set(expected "unqualified inline command-buffer owner/recording mode")
  elseif(kind STREQUAL "declaration-shape")
    set(expected "unqualified original declaration-only shader object")
  elseif(kind STREQUAL "declaration-change")
    set(expected "borrowed vertex declaration changed while bound")
  elseif(kind STREQUAL "declaration-lighting")
    set(expected "unqualified original fixed-function lighting owner")
  elseif(kind STREQUAL "borrowed-shape")
    set(expected "unqualified caller-owned CPU texture layout")
  elseif(kind STREQUAL "borrowed-extent")
    set(expected "caller texture requires owned physical backing")
  elseif(kind STREQUAL "borrowed-change")
    set(expected "borrowed CPU texture storage changed while owned")
  elseif(kind STREQUAL "borrowed-free")
    set(expected "contiguous allocation still owns registered resources")
  elseif(kind STREQUAL "vertex-change")
    set(expected "borrowed vertex storage changed while owned")
  elseif(kind STREQUAL "vertex-free")
    set(expected "contiguous allocation still owns registered resources")
  elseif(kind STREQUAL "index-shape")
    set(expected "unqualified caller-owned index header")
  elseif(kind STREQUAL "index-change")
    set(expected "borrowed index storage changed while owned")
  elseif(kind STREQUAL "index-cache")
    set(expected "index cache changed outside its binding owner")
  elseif(kind STREQUAL "index-range")
    set(expected "draw reads beyond vertex resource")
  elseif(kind STREQUAL "index-base")
    set(expected "indexed base/vertex range overflow")
  else()
    set(expected "unqualified inline graphics command at 00001b0c")
  endif()
  if(NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "inline ${kind} stopped for a different reason: ${output}${error}")
  endif()
endforeach()
