foreach(kind lighting point invalid-lighting invalid-point)
  execute_process(COMMAND "${PROGRAM}" "graphics-deferred-${kind}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(kind STREQUAL "lighting")
    set(expected "unqualified original fixed-function lighting owner")
  elseif(kind STREQUAL "point")
    set(expected "unqualified primitive/count")
  elseif(kind STREQUAL "invalid-lighting")
    set(expected "unqualified deferred lighting parameter")
  else()
    set(expected "unqualified deferred point parameter")
  endif()
  if(NOT "${result}" STREQUAL "2" OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "deferred ${kind} guard returned ${result}: ${output}${error}")
  endif()
endforeach()
